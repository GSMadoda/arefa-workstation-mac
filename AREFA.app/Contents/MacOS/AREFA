#!/bin/bash
# AREFA.app launcher — resolves the bundled workstation and runs it under the
# system python3.  Keeps a Terminal-free launch; logs to the state root.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$HERE/../Resources/arefa_workstation.py"
STATE="${AREFA_STATE_ROOT:-$HOME/Library/Application Support/AREFA}"
mkdir -p "$STATE"
PY="$(command -v python3 || true)"
if [ -z "$PY" ]; then
  osascript -e 'display alert "AREFA needs Python 3" message "Install the Xcode Command Line Tools (xcode-select --install) or python.org, then reopen AREFA."'
  exit 1
fi
exec "$PY" "$APP" >>"$STATE/arefa.log" 2>&1
